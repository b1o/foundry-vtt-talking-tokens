<div class="tt-panel">
  <p class="tt-hint">{{localize hintKey}}</p>
  <div class="tt-bubbles">
    <button type="button" class="tt-bubble tt-bubble-inherited {{#if inheritedTile.isChosen}}is-chosen{{/if}}"
            data-action="choose-bubble" data-bubble-id=""
            aria-pressed="{{#if inheritedTile.isChosen}}true{{else}}false{{/if}}"
            title="{{localize inheritedTile.labelKey}}">
      <img src="{{inheritedTile.path}}" alt="{{localize inheritedTile.labelKey}}">
      <span class="tt-bubble-caption">{{localize inheritedTile.labelKey}}</span>
    </button>
    {{#each bubbles}}
      {{> "modules/talking-tokens/templates/bubble-tile.hbs" action="choose-bubble"}}
    {{/each}}
  </div>
  <p class="tt-hint">{{localize "TALKING_TOKENS.BubbleWindow.LibraryHint"}}</p>
</div>
