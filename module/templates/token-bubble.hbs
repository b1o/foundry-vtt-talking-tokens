<div class="tt-panel">
  <p class="tt-hint">{{localize "TALKING_TOKENS.TokenBubble.Hint"}}</p>
  <div class="tt-bubbles">
    <button type="button" class="tt-bubble tt-bubble-default {{#if defaultTile.isSelected}}is-selected{{/if}}"
            data-bubble-id="" aria-pressed="{{#if defaultTile.isSelected}}true{{else}}false{{/if}}"
            title="{{localize 'TALKING_TOKENS.TokenBubble.UseDefault'}}">
      <img src="{{defaultTile.path}}" alt="{{localize 'TALKING_TOKENS.TokenBubble.UseDefault'}}">
      <span class="tt-bubble-caption">{{localize "TALKING_TOKENS.TokenBubble.AllTokens"}}</span>
    </button>
    {{#each bubbles}}
      <button type="button" class="tt-bubble {{#if isSelected}}is-selected{{/if}}" data-bubble-id="{{id}}"
              aria-pressed="{{#if isSelected}}true{{else}}false{{/if}}"
              title="{{#if labelKey}}{{localize labelKey}}{{else}}{{label}}{{/if}}">
        <img src="{{path}}" alt="{{#if labelKey}}{{localize labelKey}}{{else}}{{label}}{{/if}}">
      </button>
    {{/each}}
  </div>
  <p class="tt-hint">{{localize "TALKING_TOKENS.TokenBubble.LibraryHint"}}</p>
</div>
